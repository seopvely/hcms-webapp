# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/hcms_customer_db

# JWT
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
FRONTEND_URL=http://localhost:8011

# Server
HOST=0.0.0.0
PORT=9011
DEBUG=True

# Webhook (incoming from PACMS)
WEBHOOK_API_KEY=

# PACMS estimate approval webhook (outgoing, called after customer approves on hcms)
PACMS_API_BASE_URL=https://cms.hankyeul.com
PACMS_ESTIMATE_WEBHOOK_API_KEY=
